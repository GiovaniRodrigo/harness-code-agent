# User-level systemd unit for the Ollama daemon — no root/sudo required.
#
# Use this when you installed Ollama into your home directory (e.g. the tarball
# extracted under ~/.local) and can't use the system-wide service the official
# `install.sh` sets up. It keeps `ollama serve` running and restarts it on
# failure, per-user.
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   cp contrib/ollama.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now ollama.service
#   systemctl --user status ollama.service        # verify
#
# Survive a full reboot before you log in (optional, needs one privileged step):
#   sudo loginctl enable-linger "$USER"
#
# If Ollama lives somewhere else (e.g. /usr/local/bin/ollama), adjust ExecStart.

[Unit]
Description=Ollama local model server
Documentation=https://ollama.com
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# %h expands to the invoking user's home directory.
ExecStart=%h/.local/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
