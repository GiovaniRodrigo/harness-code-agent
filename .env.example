# API credential (or use `ant auth login`, which the SDK reads automatically).
ANTHROPIC_API_KEY=

# Optional — all have defaults in config.py.
HARNESS_MODEL=claude-opus-5
HARNESS_EFFORT=high
HARNESS_MAX_TOKENS=16000
HARNESS_WORKSPACE=./workspace
HARNESS_MAX_STEPS=40
HARNESS_TEST_COMMAND=
HARNESS_MAX_EVAL_RETRIES=3
HARNESS_CMD_TIMEOUT=120
HARNESS_MAX_TOOL_OUTPUT=16000
HARNESS_EVENT_LOG=./harness_events.jsonl
