# --- Provider selection ---
# Which LLM backend to use: anthropic | openai | google | ollama
HARNESS_PROVIDER=anthropic

# Credential for the selected provider (set the one that matches HARNESS_PROVIDER):
ANTHROPIC_API_KEY=          # anthropic (or use `ant auth login`)
OPENAI_API_KEY=             # openai
GOOGLE_API_KEY=             # google (google-genai also accepts GEMINI_API_KEY)
# ollama needs no key. Point at your Ollama host if it isn't the default:
OLLAMA_HOST=                # e.g. http://localhost:11434 (defaults to that)

# --- Optional harness settings (all have defaults in config.py) ---
# Model id. If empty, a per-provider default is used
# (anthropic=claude-opus-5, openai=gpt-4o, google=gemini-2.5-pro, ollama=llama3.1).
HARNESS_MODEL=
HARNESS_EFFORT=high          # anthropic only: low | medium | high | xhigh | max
HARNESS_MAX_TOKENS=16000
HARNESS_WORKSPACE=./workspace
HARNESS_MAX_STEPS=40
HARNESS_TEST_COMMAND=
HARNESS_MAX_EVAL_RETRIES=3
HARNESS_MAX_SUBTASKS=8         # orchestration: max subtasks executed
HARNESS_MAX_REPLANS=3         # orchestration: max planner re-plans/repairs
HARNESS_CMD_TIMEOUT=120
HARNESS_MAX_TOOL_OUTPUT=16000
HARNESS_EVENT_LOG=./harness_events.jsonl
